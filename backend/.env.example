# ==============================================================================
# TheAtom Backend Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and populate with your environment-specific credentials.
# NEVER commit the actual '.env' file containing real secrets to version control.
# ==============================================================================

# ── Application Configuration ─────────────────────────────────────────────────
APP_NAME=TheAtom
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false

# ── Server & Hosting ──────────────────────────────────────────────────────────
# Network interface and port for deployment (e.g. AWS, Render, Railway, Docker)
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:5173

# ── CORS Origins ──────────────────────────────────────────────────────────────
# Allowed frontend origins. Can be a JSON array string or comma-separated list:
# Example: ALLOWED_ORIGINS=["http://localhost:5173","https://your-production-kiosk.com"]
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:3000","http://127.0.0.1:5173"]

# ── Local / PostgreSQL Database ──────────────────────────────────────────────
# Local development defaults to SQLite. For production, supply PostgreSQL URL:
# postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///app/infrastructure/db/theatom_local.db
SYNC_DATABASE_URL=sqlite:///app/infrastructure/db/theatom_local.db

# ── Supabase (Remote Catalog & Cloud Database) ────────────────────────────────
# Required for live catalog fetching if using remote Supabase backend:
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key-here
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres

# ── Redis Cache & Session Store ───────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=3600
OBSERVATION_CACHE_TTL=300
REC_CACHE_TTL_SECONDS=45.0

# ── Google Gemini LLM ─────────────────────────────────────────────────────────
# Used for real-time natural language recommendation merchandising & semantic ranking:
GEMINI_API_KEY=your-gemini-api-key-here
GOOGLE_API_KEY=your-gemini-api-key-here
GEMINI_DEFAULT_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
GEMINI_TEMPERATURE=0.2

# ── Groq LLM (Alternative Fast Inference) ────────────────────────────────────
GROQ_API_KEY=your-groq-api-key-here
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant

# ── Voice / Speech Engine (Kokoro & Whisper) ─────────────────────────────────
TTS_ENABLED=true
KOKORO_LANG_CODE=a
STT_ENABLED=true
WHISPER_MODEL=base

# ── Multi-Tenancy & Store Branch ──────────────────────────────────────────────
DEFAULT_TENANT_ID=default
DEFAULT_BRANCH_ID=1
DEALS_ENABLED=false
